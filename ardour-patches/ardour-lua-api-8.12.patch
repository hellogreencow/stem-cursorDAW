+std::shared_ptr<MidiRegion>
+ARDOUR::LuaAPI::ensure_midi_region (Session* s, std::shared_ptr<MidiTrack> mt, double beats)
+{
+	if (!s || !mt || beats <= 0) {
+		return std::shared_ptr<MidiRegion> ();
+	}
+
+	std::shared_ptr<Playlist> pl = mt->playlist ();
+
+	if (!pl) {
+		return std::shared_ptr<MidiRegion> ();
+	}
+
+	const timecnt_t length (Temporal::Beats::from_double (beats), timepos_t (Temporal::Beats ()));
+
+	/* If this playlist already holds a MIDI region, hand back the earliest
+	 * one, growing it if the caller asked for more room than it has.
+	 */
+
+	std::shared_ptr<MidiRegion> existing;
+	std::shared_ptr<RegionList> rl = pl->region_list ();
+
+	for (RegionList::const_iterator i = rl->begin (); i != rl->end (); ++i) {
+		std::shared_ptr<MidiRegion> mr = std::dynamic_pointer_cast<MidiRegion> (*i);
+		if (!mr) {
+			continue;
+		}
+		if (!existing || mr->position () < existing->position ()) {
+			existing = mr;
+		}
+	}
+
+	if (existing) {
+		if (existing->length () < length) {
+			pl->clear_changes ();
+			existing->set_length (length);
+			s->add_command (new StatefulDiffCommand (pl));
+		}
+		return existing;
+	}
+
+	/* Nothing there yet. This mirrors MidiTimeAxisView::add_region(),
+	 * minus the editor's snapping and its own undo bracket.
+	 */
+
+	std::shared_ptr<Source> src = s->create_midi_source_by_stealing_name (mt);
+
+	if (!src) {
+		return std::shared_ptr<MidiRegion> ();
+	}
+
+	pl->clear_changes ();
+
+	const Temporal::Beats zero;
+	const timepos_t pos (zero);
+	const timecnt_t start (Temporal::BeatTime);
+
+	std::shared_ptr<Region> region;
+
+	/* the (empty) whole-file region, which appears in the source list but
+	 * is not used in any playlist
+	 */
+
+	{
+		PropertyList plist;
+
+		plist.add (ARDOUR::Properties::start, start);
+		plist.add (ARDOUR::Properties::length, length);
+		plist.add (ARDOUR::Properties::automatic, true);
+		plist.add (ARDOUR::Properties::whole_file, true);
+		plist.add (ARDOUR::Properties::name, PBD::basename_nosuffix (src->name ()));
+		plist.add (ARDOUR::Properties::opaque, s->config.get_draw_opaque_midi_regions ());
+
+		region = RegionFactory::create (src, plist);
+	}
+
+	if (!region) {
+		return std::shared_ptr<MidiRegion> ();
+	}
+
+	/* and the region actually used in the playlist */
+
+	{
+		PropertyList plist;
+		plist.add (ARDOUR::Properties::name, region->name ());
+		region = RegionFactory::create (region, plist);
+	}
+
+	if (!region) {
+		return std::shared_ptr<MidiRegion> ();
+	}
+
+	region->set_position (pos);
+	pl->add_region (region, pos, 1.0, false);
+	s->add_command (new StatefulDiffCommand (pl));
+
+	return std::dynamic_pointer_cast<MidiRegion> (region);
+}
+
+bool
+ARDOUR::LuaAPI::set_session_tempo (Session* s, double bpm)
+{
+	if (!s || bpm <= 0) {
+		return false;
+	}
+
+	Temporal::TempoMap::WritableSharedPtr map = Temporal::TempoMap::write_copy ();
+
+	if (!map) {
+		return false;
+	}
+
+	XMLNode& before (map->get_state ());
+
+	try {
+		/* constant (non-ramped) tempo in quarter notes per minute */
+		map->set_tempo (Temporal::Tempo (bpm, bpm, 4), timepos_t (Temporal::Beats ()));
+	} catch (...) {
+		delete &before;
+		Temporal::TempoMap::abort_update ();
+		return false;
+	}
+
+	if (Temporal::TempoMap::update (map)) {
+		delete &before;
+		Temporal::TempoMap::abort_update ();
+		return false;
+	}
+
+	XMLNode& after (map->get_state ());
+
+	s->begin_reversible_command (_("Set Tempo"));
+	s->add_command (new Temporal::TempoCommand (_("set tempo"), &before, &after));
+
+	if (!s->abort_empty_reversible_command ()) {
+		s->commit_reversible_command ();
+	}
+
+	return true;
+}
+
+std::string
+ARDOUR::LuaAPI::import_audio_file (Session* s, const std::string& path, samplepos_t pos)
+{
+	if (!s || path.empty ()) {
+		return std::string ();
+	}
+
+	if (!Glib::file_test (path, Glib::FILE_TEST_IS_REGULAR)) {
+		error << string_compose (_("Import: cannot open input sound file \"%1\""), path) << endmsg;
+		return std::string ();
+	}
+
+	ImportStatus status;
+
+	status.paths.push_back (path);
+	status.current = 1;
+	status.total = 1;
+	status.freeze = false;
+	status.quality = SrcBest;
+	status.replace_existing_source = false;
+	status.split_midi_channels = false;
+	status.import_markers = false;
+	status.done = false;
+	status.cancel = false;
+	status.progress = 0.0;
+
+	/* NB this is synchronous: Session::import_files() reads, converts and
+	 * writes in the calling thread and only then sets status.done. The GUI
+	 * runs it on its own thread purely so that it can show progress.
+	 */
+
+	s->import_files (status);
+	status.progress = 1.0;
+	status.done = true;
+	status.all_done = true;
+
+	if (status.cancel || status.sources.empty ()) {
+		return std::string ();
+	}
+
+	SourceList sources;
+
+	for (SourceList::const_iterator i = status.sources.begin (); i != status.sources.end (); ++i) {
+		if (!(*i)->empty ()) {
+			sources.push_back (*i);
+		}
+	}
+
+	if (sources.empty ()) {
+		return std::string ();
+	}
+
+	std::string region_name = PBD::basename_nosuffix (path);
+
+	while (RegionFactory::region_by_name (region_name)) {
+		region_name = bump_name_once (region_name, '.');
+	}
+
+	std::shared_ptr<Region> region;
+
+	{
+		PropertyList plist;
+
+		plist.add (ARDOUR::Properties::start, timecnt_t (sources[0]->type () == DataType::AUDIO ? Temporal::AudioTime : Temporal::BeatTime));
+		plist.add (ARDOUR::Properties::length, sources[0]->length ());
+		plist.add (ARDOUR::Properties::name, region_name);
+		plist.add (ARDOUR::Properties::layer, 0);
+		plist.add (ARDOUR::Properties::whole_file, true);
+		plist.add (ARDOUR::Properties::external, true);
+		plist.add (ARDOUR::Properties::opaque, true);
+
+		region = RegionFactory::create (sources, plist);
+	}
+
+	if (!region) {
+		return std::string ();
+	}
+
+	std::shared_ptr<Track> track;
+
+	if (sources[0]->type () == DataType::AUDIO) {
+		std::list<std::shared_ptr<AudioTrack> > at (
+			s->new_audio_track (sources.size (), 2, nullptr, 1, region_name,
+			                    PresentationInfo::max_order, Normal));
+		if (at.empty ()) {
+			return std::string ();
+		}
+		track = at.front ();
+	} else {
+		std::list<std::shared_ptr<MidiTrack> > mt (
+			s->new_midi_track (ChanCount (DataType::MIDI, 1), ChanCount (DataType::MIDI, 1),
+			                   Config->get_strict_io (), std::shared_ptr<PluginInfo> (), 0,
+			                   nullptr, 1, region_name, PresentationInfo::max_order, Normal, true));
+		if (mt.empty ()) {
+			return std::string ();
+		}
+		track = mt.front ();
+	}
+
+	std::shared_ptr<Playlist> pl = track->playlist ();
+
+	if (!pl) {
+		return track->id ().to_s ();
+	}
+
+	const timepos_t where (pos);
+
+	std::shared_ptr<Region> copy (RegionFactory::create (region, region->derive_properties ()));
+
+	pl->clear_changes ();
+	pl->clear_owned_changes ();
+	pl->add_region (copy, where);
+	pl->rdiff_and_add_command (s);
+
+	return track->id ().to_s ();
+}
